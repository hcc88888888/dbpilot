# Resolve these IDs during package installation. They must identify the
# unprivileged dbpilot Agent account that is allowed to call the fixed helper.
DBPILOT_AGENT_UID=19001
DBPILOT_AGENT_GID=19001

# Root-owned local upper bound for process facts exposed to the Agent. Keep
# this list aligned with locally approved signed discovery templates. Java is
# intentionally excluded because HBase observation uses bounded JMX/HTTP.
DBPILOT_PROC_ALLOWED_PROCESS_NAMES=mysqld,mariadbd,postgres,postmaster,oracle,dmserver,observer,tidb-server,gaussdb,mongod,neo4j
