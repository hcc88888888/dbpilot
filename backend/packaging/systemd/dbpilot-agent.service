[Unit]
Description=DBPilot embedded telemetry agent
Documentation=file:///usr/share/doc/dbpilot-agent/README.md
After=network-online.target dbpilot-agent-proc-helper.socket
Wants=network-online.target dbpilot-agent-proc-helper.socket

[Service]
Type=simple
User=dbpilot
Group=dbpilot
CapabilityBoundingSet=
AmbientCapabilities=
ExecStart=/usr/local/bin/dbpilot-agent --config /etc/dbpilot/agent.yaml
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/dbpilot-agent
ConfigurationDirectory=dbpilot
StateDirectory=dbpilot-agent
UMask=0077

[Install]
WantedBy=multi-user.target
