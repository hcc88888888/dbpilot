[Unit]
Description=DBPilot embedded telemetry agent
Documentation=file:///usr/share/doc/dbpilot-agent/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dbpilot
Group=dbpilot
# Native discovery reads cross-UID /proc/<pid>/exe and fd socket links. Keep the
# production Agent unprivileged and grant only the process-inspection capability.
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_PTRACE
ExecStart=/usr/local/bin/dbpilot-agent --config /etc/dbpilot/agent.yaml
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dbpilot-agent
ConfigurationDirectory=dbpilot
StateDirectory=dbpilot-agent
UMask=0077

[Install]
WantedBy=multi-user.target
