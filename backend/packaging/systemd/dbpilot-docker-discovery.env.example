# Copy to /etc/dbpilot/docker-discovery.env only after a local administrator
# explicitly opts this host into Docker discovery before Agent enrollment.
DBPILOT_DOCKER_SOCKET=/var/run/docker.sock
DBPILOT_DOCKER_DISCOVERY_SOCKET=/run/dbpilot-agent/docker-discovery.sock
DBPILOT_AGENT_UID=1001
DBPILOT_AGENT_GID=1001
DBPILOT_DOCKER_ALLOWED_LABELS=dbpilot.discovery.family,dbpilot.run
