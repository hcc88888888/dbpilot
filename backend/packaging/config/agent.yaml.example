# Install as /etc/dbpilot/agent.yaml (mode 0600, owner dbpilot:dbpilot).
# This is Agent bootstrap configuration only. Telemetry policies are signed
# DBPilot documents delivered by the control plane; do not place policy YAML,
# Collector YAML, executables, or shell commands in this file.
agent_id: replace-with-enrolled-agent-id
server_address: ingest.dbpilot.example:9443
ca_file: /etc/dbpilot/tls/ca.pem
cert_file: /etc/dbpilot/tls/agent.pem
key_file: /etc/dbpilot/tls/agent-key.pem
policy_public_key_file: /etc/dbpilot/policy-public-key.pem
# Signed JSON policy envelope, atomically replaced by the enrolled control-plane
# bootstrapper. This is never raw Collector/YAML configuration.
policy_file: /var/lib/dbpilot-agent/policy-envelope.json
data_directory: /var/lib/dbpilot-agent

# Agent-initiated command control uses the same mTLS connection but an
# independent Ed25519 command-signing key and a durable bbolt journal.
# Only command kinds backed by a registered typed executor are advertised;
# arbitrary shell command execution is never enabled.
control:
  public_key_file: /etc/dbpilot/control-command-public-key.pem
  journal_path: /var/lib/dbpilot-agent/command-journal.db
  heartbeat_interval: 30s
  reconnect_backoff: 1s

allowed_log_roots:
  - /var/log
file_collection_enabled: true

# Trusted executable base names only. Entries are normalized case-insensitively,
# matched exactly against running process names, and never executed.
database_process_names:
  - postgres
  - mysqld
  - mariadbd

# Component credentials are resolved only at runtime. For the environment
# provider, secret://hbase/reader maps to DBPILOT_SECRET_HBASE_READER.
component_secrets:
  provider: environment
component_collection:
  interval_seconds: 60
  request_timeout_seconds: 10
  max_attempts: 3
  initial_backoff_milliseconds: 100
  max_backoff_milliseconds: 2000
components:
  - id: hdfs-prod
    kind: hdfs
    endpoints:
      - url: https://namenode.example:9871/jmx
        role: namenode
    secret_ref: secret://hdfs/reader
  - id: zk-prod
    kind: zookeeper
    endpoints:
      - url: https://zookeeper.example:8080/jmx
        role: leader
    secret_ref: secret://zookeeper/reader
  - id: hbase-prod
    kind: hbase
    endpoints:
      - url: https://regionserver.example:16030/jmx
        role: regionserver
    secret_ref: secret://hbase/reader
    dependencies:
      hdfs_cluster_id: hdfs-prod
      zookeeper_cluster_id: zk-prod
