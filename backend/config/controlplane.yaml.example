# DBPilot control plane. Browser operators authenticate with short-lived OIDC
# Bearer tokens. Agent traffic remains separately authenticated with mTLS.
database_url: "postgres://dbpilot:replace-me@postgres/dbpilot?sslmode=verify-full"

http:
  address: "0.0.0.0:8443"
  tls:
    cert_file: "/run/secrets/controlplane_http_cert"
    key_file: "/run/secrets/controlplane_http_key"

identity:
  mode: "oidc"
  issuer: "https://identity.example.com"
  audience: "dbpilot-control-plane"

grpc:
  address: "0.0.0.0:9443"
  tls:
    cert_file: "/run/secrets/controlplane_grpc_cert"
    key_file: "/run/secrets/controlplane_grpc_key"
    client_ca_file: "/run/secrets/agent_client_ca"

# Enrollment is deliberately separate from the mTLS AgentControl listener.
# It authenticates the Server only; the one-time token plus Ed25519 CSR proof
# authenticates the enrolling Agent before a long-lived mTLS certificate is issued.
enrollment:
  listener:
    address: "0.0.0.0:10443"
    tls:
      cert_file: "/run/secrets/controlplane_enrollment_cert"
      key_file: "/run/secrets/controlplane_enrollment_key"
  agent_ca:
    cert_file: "/run/secrets/agent_enrollment_ca"
    key_file: "/run/secrets/agent_enrollment_ca_key"
  certificate_lifetime: 24h
  maximum_pending_hosts: 1024
  observation_delivery_timeout: 5s

webhook_allowlist:
  - "hooks.example.com"

event_url_base: "https://dbpilot.example.com"
evaluation_every: 15s
retry_every: 1m
command:
  # Credential Reference resolving to one PKCS#8 PEM Ed25519 private key.
  # The matching PKIX public key is enrolled in each Agent control config.
  signing_private_key_ref: "env://DBPILOT_COMMAND_SIGNING_PRIVATE_KEY"
  # Credential Reference resolving to exactly 32 raw bytes for AES-256-GCM.
  execution_token_key_ref: "env://DBPILOT_COMMAND_EXECUTION_TOKEN_KEY"
artifact:
  # Artifact metadata stores only paths relative to this root. The download
  # route rejects traversal, symlink escape, size drift, and checksum drift.
  storage_root: "/var/lib/dbpilot/artifacts"
  signing_key_ref: "secret://controlplane/artifact-download"
plugin_catalog:
  # Disabled is explicit during incremental rollout. When enabled, configure
  # at least one non-secret Ed25519 public key below.
  enabled: false
plugin_publishers: []
monitoring:
  maximum_instances: 200
  maximum_metrics: 50
  maximum_labels: 32
  maximum_samples: 10000
  maximum_response_bytes: 1048576
evaluation_scopes:
  - tenant_id: "tenant-1"
    project_id: "project-1"

# Static assignments remain available for legacy inspection targets. Newly
# enrolled Agent-to-scope assignments are resolved from managed_hosts; Agent
# payload fields can never override either trusted mapping.
agents:
  "spiffe-agent-id":
    tenant_id: "tenant-1"
    project_id: "project-1"
    display_name: "Production database host"
    host: "db-1.example.com"
    labels:
      role: "database"
      environment: "production"

# Optional. SMTP passwords remain env:// Secret references stored on policies;
# they are resolved only for a delivery and never serialized by the API.
smtp:
  address: "smtp.example.com:465"
  server_name: "smtp.example.com"
  username: "dbpilot@example.com"
  from: "dbpilot@example.com"
  implicit_tls: true
